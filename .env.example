# 仅服务端使用，从 https://developer.zhihu.com/profile 获取；不要提交真实密钥。
ZHIHU_ACCESS_SECRET=

# 可选：服务端身份绑定。访问其他授权用户时必须显式设置 oauth。
ZHIHU_USER_AUTH_MODE=self
ZHIHU_OAUTH_TOKEN=
# 毫秒级过期时间；外部注入 token 时建议提供
ZHIHU_OAUTH_EXPIRES_AT=

# 可选：OAuth 应用信息；所有密钥只在服务端保存
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=
# 一次性授权码应由可信后端回调注入，不建议长期写入 .env
ZHIHU_OAUTH_AUTHORIZATION_CODE=
